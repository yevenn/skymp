<Window x:Class="Numidium.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numidium" Width="1180" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#16161A" Foreground="#E8E4DA"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#202026"/>
        <SolidColorBrush x:Key="Muted" Color="#9A958A"/>
        <SolidColorBrush x:Key="Accent" Color="#C9A45C"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A31"/>
            <Setter Property="Foreground" Value="#E8E4DA"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#E8E4DA"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2E2E36"/>
            <Setter Property="Foreground" Value="#E8E4DA"/>
            <Setter Property="BorderBrush" Value="#44444D"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- Setup -->
        <DockPanel Grid.Column="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="NUMIDIUM" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Text roleplay in Skyrim" Foreground="{StaticResource Muted}"/>
            </StackPanel>

            <!-- Steam's Skyrim: the source of the base game -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="SKYRIM SPECIAL EDITION (STEAM)"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="BrowseSteam_Click"/>
                        <TextBox x:Name="SteamDirBox" IsReadOnly="True"/>
                    </DockPanel>
                    <TextBlock x:Name="SteamStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- The Numidium copy the game runs from -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="NUMIDIUM GAME FOLDER"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="BrowseGame_Click"/>
                        <TextBox x:Name="GameDirBox" LostFocus="GameDirBox_LostFocus"/>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Set up" Margin="8,0,0,0" Click="Copy_Click"/>
                        <TextBlock x:Name="GameStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <ProgressBar x:Name="CopyProgress" Height="4" Margin="0,8,0,0" Visibility="Collapsed"
                                 Background="#2A2A31" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                    <TextBlock Style="{StaticResource Heading}" Text="NUMIDIUM CLIENT PACKAGE" Margin="0,12,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Releases" Margin="8,0,0,0" Click="UseReleases_Click"
                                ToolTip="Use the newest release on GitHub instead of a local folder"/>
                        <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="BrowsePackage_Click"
                                ToolTip="Test a package from a local folder (package-client.ps1's output)"/>
                        <TextBox x:Name="PackageDirBox" IsReadOnly="True"/>
                    </DockPanel>
                    <TextBlock x:Name="PackageStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="ServerChoiceButton" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="8,0,0,0"
                                Click="ServerChoice_Click"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="SERVER"/>
                            <TextBlock x:Name="ServerName" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- Another server than Numidium's: a home or test server -->
                    <Grid x:Name="CustomServerFields" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Heading}" Text="ADDRESS"/>
                            <TextBox x:Name="HostBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Heading}" Text="PORT"/>
                            <TextBox x:Name="PortBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Heading}" Text="PROFILE (DEV)"/>
                            <TextBox x:Name="ProfileBox" ToolTip="Only offline test servers use this; servers with Discord sign-in ignore it"/>
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="SignInButton" DockPanel.Dock="Right" Content="Sign in with Discord" Margin="8,0,0,0"
                                Click="SignIn_Click" ToolTip="Opens Discord in your browser; the server only learns your Discord id and name"/>
                        <TextBlock x:Name="AccountStatus" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                   Text="Play asks the server whether it needs a Discord sign-in."/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Button x:Name="PlayButton" DockPanel.Dock="Bottom" Content="Play" FontSize="18" FontWeight="SemiBold" Padding="0,10"
                    Background="{StaticResource Accent}" Foreground="#16161A" BorderThickness="0" Click="Play_Click"/>
        </DockPanel>

        <!-- Mods and log -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Content="Refresh" Margin="8,0,0,0" Click="RefreshMods_Click"/>
                        <TextBlock x:Name="ModsHeading" Style="{StaticResource Heading}" Text="MODS" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Downloads folder" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="BrowseDownloads_Click"/>
                        <TextBox x:Name="DownloadsDirBox" IsReadOnly="True"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="InstallModsButton" DockPanel.Dock="Right" Content="Install downloaded" Click="InstallMods_Click"/>
                        <TextBlock x:Name="ModsStatus" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                    </DockPanel>
                    <ListView x:Name="ModsList" Background="#1B1B20" BorderBrush="#2E2E36" Foreground="#E8E4DA"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ModName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#9A958A" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                    <Button Grid.Column="2" Content="Nexus" Padding="8,2" FontSize="12" Tag="{Binding PageUrl}"
                                            Click="OpenOnNexus_Click" ToolTip="Open this file on Nexus Mods to download it"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Muted}"/>
        </Grid>
    </Grid>
</Window>
